{
	admin off
	auto_https off
}

http://172.17.0.1:19080 {
	bind 172.17.0.1
	encode zstd gzip
	redir /console /console/ 301
	redir /grafana /grafana/ 301
	handle_path /console/* {
		import /run/secrets/auth.caddy
		reverse_proxy 127.0.0.1:19500 {
			flush_interval -1
		}
	}
	handle /grafana/* {
		import /run/secrets/auth.caddy
		reverse_proxy 127.0.0.1:19501
	}
	handle {
		root * /srv/site
		file_server
	}
}
